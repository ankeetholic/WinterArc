# ==============================================================================
# Winter Arc Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Backend (Django)
DEBUG=True
SECRET_KEY=your-secure-django-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (Online Supabase / PostgreSQL)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# AI & LLM Engine (Google Gemini / OpenAI)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
# Or OpenAI:
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4o-mini
