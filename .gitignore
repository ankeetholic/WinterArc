# ==============================================================================
# Winter Arc .gitignore
# Push only clean source code; exclude dependencies, caches, docs, and secrets.
# ==============================================================================

# Documentation & Specifications (as requested)
docs/
*.pdf
*.png
*.jpg
*.jpeg
*.svg.tmp

# Environment & Secrets (NEVER COMMIT CREDENTIALS)
.env
.env.*
!.env.example

# Python / Django
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Testing & Coverage
.coverage
htmlcov/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
out/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editor Configs
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Scratch / Temporary
scratch/
tmp/
temp/
